# Copy to .env and fill in. Never commit .env.

# --- Core ---
DOMAIN=                       # VPS only: e.g. schedler-evans.duckdns.org (Caddy gets HTTPS for it)
APP_ENV=local                 # local | production
DRY_RUN=true                  # true = fake publishers, nothing is really posted
APP_BASE_URL=http://localhost:8000 # dashboard URL used in Telegram links (https://<host> on the VPS)
TZ_DEFAULT=Asia/Jakarta
SECRET_KEY=                   # python -c "import secrets;print(secrets.token_urlsafe(48))"
FERNET_KEY=                   # required (encrypts IG tokens): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ADMIN_PASSWORD_HASH=          # paste the whole line printed by: python -m app.cli hash-password (keep the single quotes)
DATABASE_URL=sqlite:///./data/schedler.db
SCHEDULER_ENABLED=true        # false only in tests; background jobs run inside the API process

# --- Storage ---
STORAGE_BACKEND=r2            # r2 (local dev) | local_public (VPS)
MEDIA_DIR=./media
PUBLIC_MEDIA_BASE_URL=        # local_public only: http://localhost:8000/m (Mac) or https://<host>/m (VPS)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=schedler-media
R2_PUBLIC_BASE_URL=           # https://pub-xxxx.r2.dev

# --- Platform limits (verify against current platform docs) ---
IG_REELS_MAX_SECONDS=900
TIKTOK_MAX_SECONDS=600

# --- Instagram (Instagram API with Instagram Login) ---
META_APP_ID=                  # only for an OAuth flow (not built yet); pasted tokens need neither
META_APP_SECRET=
IG_GRAPH_VERSION=v27.0        # latest in Meta's Graph API changelog (2026-11)

# --- Buffer ---
BUFFER_API_KEYS=              # comma-separated; one per legitimately owned organization (publish.buffer.com/settings/api)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=           # from @BotFather; empty = notifications wait in the outbox
TELEGRAM_CHAT_ID=             # your chat id (send /start to the bot first)
